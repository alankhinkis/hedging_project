# Copy to .env (which is gitignored) and fill in your WRDS login.
# The PASSWORD DOES NOT GO HERE. Put it in ~/.pgpass instead:
#
#   wrds-pgdata.wharton.upenn.edu:9737:wrds:<username>:<password>
#
# On Windows that file lives at %APPDATA%\postgresql\pgpass.conf
# (C:\Users\<you>\AppData\Roaming\postgresql\pgpass.conf), one line, no quotes.
# Alternatively run `python -c "import wrds; wrds.Connection()"` once and answer the
# prompt with "y" when it offers to create the pgpass entry for you.

WRDS_USERNAME=
